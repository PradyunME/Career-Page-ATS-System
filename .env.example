# SMTP sender account. Use an app password (not your normal account password)
# if your mail provider requires it, such as Gmail with 2-Step Verification.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-sender@gmail.com
SMTP_PASSWORD=replace-with-an-app-password

# The mailbox that receives applications.
APPLICATIONS_TO=your-recruiting-inbox@gmail.com
# Optional: must be an address/name the SMTP account is allowed to send as.
MAIL_FROM=your-sender@gmail.com

# Max uploaded resume file size in megabytes.
MAX_RESUME_SIZE_MB=10
